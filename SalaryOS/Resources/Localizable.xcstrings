    "work.estimate-disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gross estimate only. Taxes, overtime premiums, night work and holiday rates are not included. Record actual salary separately."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai bruto summas aplēse. Nodokļi, virsstundu, nakts darba un svētku dienu piemaksas nav iekļautas. Faktisko algu reģistrējiet atsevišķi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только оценка начислений до налогов. Налоги, сверхурочные, ночные и праздничные ставки не учтены. Фактическую зарплату записывайте отдельно."
          }
        }
      }
    },
