    "salary.recorded-breakdown-note": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Figures are stored with this payment and can be edited to match your payslip. The annual comparison is an estimate, not a tax declaration."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rādītāji tiek saglabāti kopā ar šo izmaksu; tos var pielāgot algas aprēķinam. Gada salīdzinājums ir aptuvens, nevis deklarācija."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показатели сохраняются вместе с выплатой и их можно скорректировать по расчётному листку. Годовое сравнение является оценкой, а не декларацией."
          }
        }
      }
    },
