    "salary.disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate for standard employment under Latvia’s 2026 rules. It excludes solidarity tax settlement, minimum social contribution reconciliation, annual deductions and declaration adjustments."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprēķins standarta darba attiecībām pēc Latvijas 2026. gada noteikumiem. Nav iekļauts solidaritātes nodokļa norēķins, minimālo sociālo iemaksu pārrēķins, gada atvieglojumi un deklarācijas korekcijas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка для стандартных трудовых отношений по правилам Латвии на 2026 год. Не учитываются расчёт налога солидарности, перерасчёт минимальных социальных взносов, годовые вычеты и корректировки декларации."
          }
        }
      }
    },
