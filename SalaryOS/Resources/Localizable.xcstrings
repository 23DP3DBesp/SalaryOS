    "salary.annual-reconciliation-disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate based only on salary records saved here. Other income, deductions, benefits, and declaration adjustments are not included."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aptuvens aprēķins, balstīts tikai uz šeit saglabātajām algām. Citi ienākumi, atvieglojumi un deklarācijas korekcijas nav iekļautas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оценка только по зарплатам, сохранённым здесь. Другие доходы, вычеты, льготы и корректировки декларации не учтены."
          }
        }
