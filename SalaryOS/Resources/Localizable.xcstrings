    "loan.estimate-disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Estimate only. Variable rates use the recorded rate history; extra repayments are applied at monthly period boundaries. Bank fees or contract rules may change the actual schedule."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tikai aptuvens aprēķins. Mainīgajām likmēm izmanto reģistrēto likmju vēsturi; papildu maksājumi tiek piemēroti mēneša perioda sākumā. Bankas maksas vai līguma noteikumi var mainīt faktisko grafiku."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только оценка. Для переменных ставок используется сохранённая история ставок; досрочные платежи учитываются на границе месяца. Комиссии банка и условия договора могут изменить реальный график."
          }
        }
      }
    },
    "loan.ledger-disclaimer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loan estimates and extra repayments do not change account balances. Record actual payments separately as transactions."
          }
        },
        "lv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aizdevuma aprēķins un papildu atmaksa nemaina konta atlikumu. Faktiskos maksājumus reģistrējiet atsevišķi kā darījumus."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расчёт кредита и досрочные погашения не меняют баланс счёта. Фактические платежи записывайте отдельно как транзакции."
          }
        }
      }
    },
